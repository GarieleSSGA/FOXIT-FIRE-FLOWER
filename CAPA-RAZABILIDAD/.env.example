# Credenciales Foxit — plantilla. Copiar a .env y completar.
# NO subir .env al repositorio. Ya está en .gitignore.

# ---------------------------------------------------------------- PDF Services
# Portal: https://app.developer-api.foxit.com/dashboard
# Autenticación: headers client_id + client_secret. Sin token.
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=

# Host verificado por DNS. NO usar api.foxit.com: resuelve pero no sirve.
FOXIT_BASE_URL=https://na1.fusion.foxit.com

# ---------------------------------------------------------------- eSign
# Host REGIONAL verificado: na1=US, eu1=EU, au1=AU, na2=CA.
# NO usar api.foxitesign.com ni esign.foxit.com: no existen en DNS.
FOXIT_ESIGN_BASE_URL=https://na1.foxitesign.foxit.com/api

# eSign requiere credenciales de un PORTAL SEPARADO, no las de PDF Services.
# Solicitar en https://developer-api.foxit.com/esign (Contact Sales).
# Con las credenciales de PDF Services, eSign responde:
#   {"error":"invalid_client","error_description":"invalid consumer credentials"}
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=

# ---------------------------------------------------------------- PDF Embed
# Client ID del visor embebido. Mismo dashboard que PDF Services.
FOXIT_EMBED_CLIENT_ID=

# ---------------------------------------------------------------- App
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------- Verificación
# node diag_credenciales.mjs   comprueba qué APIs responden con estas claves
# node verify_integrity.js     verifica el vault sin usar la base de datos
